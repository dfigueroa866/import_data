{
  "source_name": "location",
  "source_type": "file",
  "description": "Catálogo de ubicaciones en public.locations",
  "connection_config": {
    "read_options": {
      "delimiter": ",",
      "encoding": "utf-8",
      "header": 0,
      "na_values": ["", "NULL", "null", "N/A", "n/a", "NA"],
      "keep_default_na": true
    }
  },
  "validation_rules": {
    "not_null": {
      "columns": [
        "code",
        "name",
        "loc_type",
        "country",
        "state",
        "city",
        "timezone",
        "status"
      ],
      "severity": "critical"
    },
    "unique": {
      "columns": ["code"],
      "severity": "critical"
    },
    "data_type": {
      "strict": false,
      "types": {},
      "severity": "error"
    }
  },
  "transformation_rules": [
    {
      "name": "clean_whitespace",
      "columns": ["code", "name", "country", "state", "city", "timezone", "loc_type", "status"]
    }
  ],
  "target_table": "stage_location",
  "target_schema": "staging_data",
  "production_table": "locations",
  "production_schema": "public",
  "is_active": true,
  "load_type": "catalog",
  "processing_config": {
    "batch_size": 5000,
    "max_retries": 3,
    "timeout_seconds": 300
  },
  "metadata": {
    "catalog_table": "location",
    "unique_keys": ["organization_id", "code"],
    "required_columns": [
      "code",
      "name",
      "loc_type",
      "country",
      "state",
      "city",
      "timezone",
      "status"
    ],
    "optional_columns": []
  }
}
