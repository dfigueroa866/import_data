# API base URL. Leave empty in local dev to use Vite proxy (vite.config.js → 127.0.0.1:8000).
# Do NOT use http://localhost:8000 on Windows if another service binds [::1]:8000.
VITE_API_URL=

# Production example:
# VITE_API_URL=http://127.0.0.1:8000

# Minutos de inactividad antes de cerrar sesión (debe coincidir con ACCESS_TOKEN_EXPIRE_MINUTES del backend).
# VITE_SESSION_INACTIVITY_MINUTES=15
