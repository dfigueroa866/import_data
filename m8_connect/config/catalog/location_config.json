{
  "source_name": "location",
  "source_type": "file",
  "description": "Catálogo de ubicaciones en public.location",
  "connection_config": {
    "read_options": {
      "delimiter": ",",
      "encoding": "utf-8",
      "header": 0,
      "na_values": ["", "NULL", "null", "N/A", "n/a", "NA"],
      "keep_default_na": true
    }
  },
  "validation_rules": {
    "not_null": {
      "columns": ["organization_id", "location_code", "location_name"],
      "severity": "critical"
    },
    "unique": {
      "columns": ["location_code"],
      "severity": "critical"
    },
    "data_type": {
      "strict": false,
      "types": {
        "is_active": "bool"
      },
      "severity": "error"
    }
  },
  "transformation_rules": [
    {
      "name": "clean_whitespace",
      "columns": ["location_code", "location_name", "country", "city", "timezone", "location_type"]
    }
  ],
  "target_table": "stage_location",
  "target_schema": "staging_data",
  "production_table": "location",
  "production_schema": "public",
  "is_active": true,
  "load_type": "catalog",
  "processing_config": {
    "batch_size": 5000,
    "max_retries": 3,
    "timeout_seconds": 300
  },
  "metadata": {
    "catalog_table": "location",
    "unique_keys": ["organization_id", "code"],
    "required_columns": ["organization_id", "location_code", "location_name"],
    "optional_columns": ["country", "city", "timezone", "is_active", "location_type"]
  }
}
