# Variables para docker-compose.tunnel.yml
# Copiar a: docker/.env.tunnel

# Servidor Ubuntu (SSH)
SSH_HOST=203.0.113.10
SSH_PORT=22
SSH_USER=ubuntu

# Ruta ABSOLUTA a tu clave privada en el host (Windows: usar /c/Users/... o ruta WSL)
SSH_KEY_PATH=~/.ssh/id_rsa

# PostgreSQL en el servidor Ubuntu (visto desde el propio servidor)
REMOTE_PG_HOST=127.0.0.1
REMOTE_PG_PORT=5432

# Puerto en tu máquina local donde escuchará el túnel
LOCAL_TUNNEL_PORT=5433
