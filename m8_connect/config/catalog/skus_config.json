{
  "source_name": "skus",
  "source_type": "file",
  "description": "Catálogo de productos (SKUs) en public.skus",
  "connection_config": {
    "read_options": {
      "delimiter": ",",
      "encoding": "utf-8",
      "header": 0,
      "na_values": ["", "NULL", "null", "N/A", "n/a", "NA"],
      "keep_default_na": true
    }
  },
  "validation_rules": {
    "not_null": {
      "columns": [
        "organization_id",
        "sku",
        "name",
        "status",
        "subcategory",
        "class",
        "subclass",
        "attr_1",
        "attr_2",
        "attr_3",
        "attr_4",
        "attr_5",
        "attr_6",
        "vendor_id"
      ],
      "severity": "critical"
    },
    "unique": {
      "columns": ["sku"],
      "severity": "critical"
    },
    "lookup_validation": {
      "lookups": {
        "status": {
          "type": "values",
          "values": ["active", "inactive", "discontinued", "new_launch"],
          "case_sensitive": false
        }
      },
      "severity": "error"
    }
  },
  "transformation_rules": [
    {
      "name": "clean_whitespace",
      "columns": [
        "sku",
        "name",
        "category",
        "brand",
        "status",
        "subcategory",
        "class",
        "subclass",
        "attr_1",
        "attr_2",
        "attr_3",
        "attr_4",
        "attr_5",
        "attr_6",
        "vendor_id"
      ]
    }
  ],
  "target_table": "stage_skus",
  "target_schema": "staging_data",
  "production_table": "skus",
  "production_schema": "public",
  "is_active": true,
  "load_type": "catalog",
  "processing_config": {
    "batch_size": 5000,
    "max_retries": 3,
    "timeout_seconds": 300
  },
  "metadata": {
    "catalog_table": "skus",
    "unique_keys": ["organization_id", "sku"],
    "required_columns": [
      "organization_id",
      "sku",
      "name",
      "status",
      "subcategory",
      "class",
      "subclass",
      "attr_1",
      "attr_2",
      "attr_3",
      "attr_4",
      "attr_5",
      "attr_6",
      "vendor_id"
    ],
    "optional_columns": ["category", "brand"]
  }
}
