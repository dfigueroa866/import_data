{
  "rules": {
    "completeness": {
      "threshold": 0.95
    },
    "not_null": {
      "columns": [
        "required_column1",
        "required_column2"
      ]
    },
    "unique": {
      "columns": [
        "id_column"
      ]
    },
    "email": {
      "columns": [
        "email_column"
      ]
    },
    "range": {
      "columns": {
        "age": {
          "min": 0,
          "max": 120
        },
        "price": {
          "min": 0
        }
      }
    },
    "pattern": {
      "columns": {
        "phone": "^\\+?[\\d\\s\\-\\(\\)]+$"
      }
    }
  },
  "quality_thresholds": {
    "minimum_score": 85,
    "warning_score": 95,
    "block_on_critical": true
  }
}