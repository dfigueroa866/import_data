# Plantilla de configuración — copiar a .env y completar valores
# PostgreSQL en Ubuntu vía túnel Docker: ver docs/CONFIGURACION_POSTGRESQL_TUNEL.md

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================================================
# PostgreSQL (recomendado) — túnel Docker → localhost
# ============================================================================
# El host SIEMPRE es 127.0.0.1 y el puerto el de LOCAL_TUNNEL_PORT (ej. 5433)
DATABASE_URL=postgresql://staging_user:CAMBIAR_PASSWORD@127.0.0.1:5433/staging_db
DATABASE_TYPE=postgresql

# Túnel local: normalmente no hace falta SSL entre app y localhost
SSL_REQUIRE=false
SSL_MODE=prefer

# Pool workers (run_workers.py)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Pool API (run_app.py) — subir si hay cargas grandes y polling concurrente
API_DB_POOL_SIZE=25
API_DB_MAX_OVERFLOW=45

# Throttle de progreso en workers (cargas 9M+ filas)
PROGRESS_COMMIT_EVERY_CHUNKS=2
PROGRESS_ROW_INTERVAL=50000
PROGRESS_UPDATE_INTERVAL_SEC=15
PROMOTION_PROGRESS_EVERY_CHUNKS=3
PROMOTION_BATCH_SIZE=250000
PROMOTION_WORK_MEM=512MB
PROMOTION_METADATA_EVERY_CHUNKS=3
USE_VALIDATION_MULTIPROCESSING=false
VALIDATION_WORKER_PROCESSES=2
PARALLEL_VALIDATION_MIN_ROWS=500000
ARROW_COPY_MIN_ROWS=10000
VECTORIZED_ID_MIN_ROWS=10000
PROCESS_CHUNK_SIZE=250000

# ============================================================================
# ClickHouse (opcional — desactivado por defecto)
# ============================================================================
# DATABASE_URL=clickhouse://user:pass@host:8443/default?protocol=https
# DATABASE_TYPE=clickhouse

# ============================================================================
# Supabase (opcional — desactivado por defecto)
# ============================================================================
# DATABASE_URL=postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:5432/postgres
# DATABASE_TYPE=supabase

# ============================================================================
# API y archivos
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
UPLOAD_PATH=./data/uploads
TEMP_PATH=./data/temp
BACKUP_PATH=./backups

SECRET_KEY=generar-clave-segura-de-al-menos-32-caracteres-para-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_INACTIVITY_MINUTES=15
