          "active",
          "inactive",
          "discontinued"
        ]
      },
      "defaults": {},
      "validation_hints": [
        "Clave única: (organization_id, code)",
        "code es el SKU del producto (no uses la columna de archivo sku_id; es el UUID de la BD)",
